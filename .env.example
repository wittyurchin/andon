# Copy to .env — every value here is optional.
# The app runs with no configuration at all: real weather from Open-Meteo and
# NOAA METAR (no keys needed), roads from OpenStreetMap, mock traffic and
# incidents, and rule-based reports. Every source that cannot run is listed in
# source health with the exact reason.
# Full reference: docs/data-layer.md. Provider facts: docs/provider-verification.md.

# --- mode -------------------------------------------------------------------
# auto = real sources where free or credentialed, mocks elsewhere.
# mock = simulated (the "demo" scenario) — except that any key set below
#        replaces its mock, in either mode. A bad or exhausted key fails
#        loudly; it never falls back to a mock.
ANDON_MODE=auto

# --- LLM reasoning ----------------------------------------------------------
# Without a key, reports are written by the deterministic rules engine and the
# UI says so. With one, Claude writes them.
# ANTHROPIC_API_KEY=sk-ant-...
ANDON_LLM_ENABLED=true
ANDON_LLM_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Classification is already done by the
# rules engine, so this task does not need deep reasoning.
ANDON_LLM_EFFORT=low
# Never serve a report older than this, even if nothing changed (seconds).
ANDON_LLM_MAX_REPORT_AGE_S=1800

# --- providers --------------------------------------------------------------
# Comma-separated lists; every listed provider runs and gets its own card.
# "auto" resolves per ANDON_MODE (see docs/data-layer.md#provider-configuration).
#   weather:   open_meteo | awc_metar | imd | ksndmc | openweathermap | mock | mock_station
#   traffic:   tomtom | mappls | mock | mock_outage
#   incidents: tomtom | mappls | btp | bmc | mock
#   radar:     rainviewer | mock | none
ANDON_WEATHER_PROVIDERS=auto
ANDON_TRAFFIC_PROVIDERS=auto
ANDON_INCIDENT_PROVIDERS=auto
ANDON_RADAR_PROVIDERS=auto
# Older single-provider settings (ANDON_WEATHER_PROVIDER, ANDON_TRAFFIC_PROVIDER,
# ANDON_INCIDENT_PROVIDER) are still honoured when the plural one is "auto".

# TomTom — live traffic flow + incidents (developer.tomtom.com).
# ANDON_TOMTOM_API_KEY=

# Open-Meteo — the free API is non-commercial only. A commercial key switches
# to customer-api.open-meteo.com.
# ANDON_OPEN_METEO_API_KEY=

# OpenWeatherMap — free, no card needed for this endpoint. Unlike Open-Meteo's
# free tier, this one permits commercial use. Its severe-weather alerts are a
# separate paid product that needs billing details even for the free portion,
# so alerts are not fetched here.
# ANDON_OPENWEATHERMAP_API_KEY=

# NOAA AWC METAR — how far to look for a reporting station.
ANDON_METAR_SEARCH_RADIUS_KM=120

# IMD — needs a key AND the key's transport, which IMD does not document.
# Set exactly one of the header / query-param names IMD issues with the key.
# ANDON_IMD_API_KEY=
# ANDON_IMD_AUTH_HEADER=
# ANDON_IMD_AUTH_QUERY_PARAM=
# ANDON_IMD_AWS_STATE_ID=
# ANDON_IMD_BASE_URL=https://api.imd.gov.in/api/v1

# Mappls — static key from the Mappls console, sent as the access_token query
# parameter. Used for corridor travel times via Predictive Routing, which must
# be enabled for the key.
# ANDON_MAPPLS_ACCESS_TOKEN=
# Also fetch the "optimal" ETA for comparison (it is NOT free-flow).
ANDON_MAPPLS_COMPARE_OPTIMAL=true

# RainViewer radar — free API is for personal and educational use only.
# Never called unless you acknowledge that your use qualifies.
ANDON_RAINVIEWER_TERMS_ACKNOWLEDGED=false

# How far around the restaurant counts as "local".
ANDON_LOCAL_RADIUS_M=900
ANDON_INCIDENT_RADIUS_KM=5.0
ANDON_PROVIDER_TIMEOUT_S=8.0

# --- caching (keeps a 1-min auto-refresh off the external APIs) -------------
ANDON_WEATHER_CACHE_TTL_S=240
ANDON_TRAFFIC_CACHE_TTL_S=120
ANDON_INCIDENT_CACHE_TTL_S=180
ANDON_RADAR_CACHE_TTL_S=300

# --- restaurant access graph -----------------------------------------------
# auto = OpenStreetMap (Overpass), falling back to configured points, then a
# radial approximation. mock = simulated roads.
ANDON_ACCESS_GRAPH_SOURCE=auto
ANDON_ACCESS_GRAPH_RADIUS_M=700
ANDON_ACCESS_MAX_APPROACHES=6
ANDON_ACCESS_GRAPH_MAX_AGE_DAYS=30
# Comma-separated; later entries are fallbacks.
ANDON_OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter
# Operator-supplied approach points when no road graph can be derived:
# ANDON_ACCESS_POINTS=[{"label": "Main gate", "lat": 12.912, "lon": 77.651}]

# --- persistence -----------------------------------------------------------
# SQLite file (relative to where the backend runs). Holds restaurants,
# observations, incidents, source health, access graphs, changes and history.
ANDON_DATABASE_PATH=data/andon.sqlite3
ANDON_RETENTION_DAYS=14

# --- freshness (seconds) ---------------------------------------------------
# Per evidence class; defaults: weather_station 900, weather_model 1800,
# radar 600, traffic 300, incident 600.
# ANDON_FRESHNESS_POLICIES={"traffic": 240}
# Per source; default {"awc-metar": 2700} (Indian METARs are half-hourly).
# ANDON_SOURCE_FRESHNESS_OVERRIDES={"awc-metar": 3600}
# Display grades used by the situation cards.
ANDON_FRESHNESS_FRESH_S=300
ANDON_FRESHNESS_RECENT_S=900
ANDON_FRESHNESS_AGING_S=2700

# --- change detection ------------------------------------------------------
# Congestion-index move (0–1) and travel-time change (%) that count as a change.
ANDON_CHANGE_TRAFFIC_INDEX_DELTA=0.15
ANDON_CHANGE_TRAVEL_TIME_PCT=25

# --- background polling ----------------------------------------------------
# Refresh every registered restaurant's evidence on its own interval, even with
# no dashboard open. Off by default: it calls external APIs around the clock.
# Never calls the LLM.
ANDON_BACKGROUND_POLLING=false
ANDON_POLL_TICK_S=15

# --- history ---------------------------------------------------------------
ANDON_HISTORY_MAX_SNAPSHOTS=288

# --- mock scenario (only affects mock providers) ---------------------------
# calm | deteriorating | storm | clearing | demo  (ANDON_MODE=mock forces demo)
ANDON_MOCK_SCENARIO=deteriorating
ANDON_MOCK_RAMP_MINUTES=20

# --- app -------------------------------------------------------------------
ANDON_HOST=0.0.0.0
ANDON_PORT=8000
ANDON_LOG_LEVEL=INFO
ANDON_LOG_JSON=true
ANDON_CORS_ORIGINS=["http://localhost:5173"]
# Where the built UI lives. Only needed when the package is installed away
# from the repo layout; the default finds ./frontend/dist.
# ANDON_FRONTEND_DIST=/srv/andon/frontend/dist
